---
import Nav from '@src/components/Nav.astro';
import Seo from '@src/components/Seo';
import HtmlLayout from '@src/layouts/Html.astro';
import BodyLayout from '@src/layouts/Body.astro';
import HeadLayout from '@src/layouts/Head.astro';
import Footer from '@src/components/Footer';
import Markdown, { renderMarkdown } from '@src/components/Markdown';
import ReactMorpheusHero from '@src/components/ReactMorpheusHero';

const reactMorpheusReadmeUrl =
  'https://raw.githubusercontent.com/shivekkhurana/react-morpheus/refs/heads/master/README.md';

function removeDemoSection(markdown: string): string {
  return markdown
    .replace(
      /\n?## Demo\s*\n+<!-- react-morpheus-demo:start -->[\s\S]*?<!-- react-morpheus-demo:end -->\s*/u,
      '\n'
    )
    .trim();
}

async function fetchReactMorpheusReadme(): Promise<string> {
  const response = await fetch(reactMorpheusReadmeUrl);

  if (!response.ok) {
    throw new Error(
      `Failed to fetch React Morpheus README: ${response.status} ${response.statusText}`
    );
  }

  return removeDemoSection(await response.text());
}

const docsParsedMd = await renderMarkdown(await fetchReactMorpheusReadme());
---

<HtmlLayout>
  <HeadLayout>
    <Seo
      title="Fluid Component Morphing for React Interfaces"
      subTitle="React Morpheus preserves spatial contact from original component to final interaction. This makes UI state feel grounded and intuitive."
      tags="react,react-morpheus,morpheus,framer motion,ui animation,typescript"
      authorName="Shivek Khurana"
      heroImg="/img/react-morpheus-cover.png"
      canonicalUrl="https://shivekkhurana.com/react-morpheus"
    />
  </HeadLayout>

  <BodyLayout>
    <div class="react-morpheus-page">
      <Nav />
      <main>
        <ReactMorpheusHero client:idle />

        <section class="mx-auto w-11/12 max-w-6xl py-16 md:py-24">
          <Markdown
            parsedMd={docsParsedMd}
            className="markdown-full-width"
          />
        </section>
      </main>
      <Footer />
    </div>
  </BodyLayout>
</HtmlLayout>
