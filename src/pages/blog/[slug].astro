---
import clsx from 'clsx';

import NavV2 from '@src/components/NavV2.astro';
import Post from '@src/components/Post';
import { getAllPosts, getAuthorBySlug } from '@src/domain/content';
import Seo from '@src/components/Seo';
import StructuredData from '@src/components/StructuredData';
import HtmlLayout from '@src/layouts/Html.astro';
import BodyLayout from '@src/layouts/Body.astro';
import HeadLayout from '@src/layouts/Head.astro';
import Footer from '@src/components/Footer';
import image from '@src/utils/image';

export async function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((p) => {
    return { params: { slug: p.slug }, props: { post: p } };
  });
}

const { post } = Astro.props;
const author = getAuthorBySlug(post.author);
const postOgImg = post.heroImg ? image.getOgJpgSrc(post.heroImg) : post.heroImg;
---

<HtmlLayout>
  <HeadLayout>
    <Seo
      title={post.title}
      subTitle={post.subTitle}
      tags={post.tags}
      heroImg={postOgImg}
      canonicalUrl={post.canonicalUrl}
      authorName={author.name}
      ogType="article"
      publishedOn={post.publishedOn}
    />
    <StructuredData
      title={post.title}
      subTitle={post.subTitle}
      tags={post.tags}
      heroImg={postOgImg}
      authorName={author.name}
      publishedOn={post.publishedOn}
      url={`https://shivekkhurana.com/blog/${post.slug}`}
    />
  </HeadLayout>

  <BodyLayout>
    <NavV2 />
    <Post post={post} />
    <Footer />
  </BodyLayout>
</HtmlLayout>
