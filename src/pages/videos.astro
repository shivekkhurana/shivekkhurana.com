---
import clsx from 'clsx';
import Nav from '@src/components/Nav.astro';
import Seo from '@src/components/Seo';
import HtmlLayout from '@src/layouts/Html.astro';
import BodyLayout from '@src/layouts/Body.astro';
import HeadLayout from '@src/layouts/Head.astro';
import Footer from '@src/components/Footer';
import { getSortedVideos } from '@src/domain/content';
import VideoCard from '@src/components/VideoCard';

const videos = getSortedVideos();
---

<HtmlLayout>
  <HeadLayout>
    <Seo
      title="Videos - Shivek Khurana"
      subTitle="Talks and podcasts"
      authorName="Shivek Khurana"
      heroImg="/img/og.png"
    />
  </HeadLayout>

  <BodyLayout>
    <Nav />
    <main class={clsx('w-11/12 mx-auto lg:w-6/12', 'mt-16 mb-24')}>
      <section class="font-mlm-roman">
        <h1 class="text-2xl font-bold font-mlm-roman mb-8">Videos</h1>
        <div class="grid grid-cols-3 gap-5">
          {videos.map((video) => (
            <VideoCard video={video} />
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </BodyLayout>
</HtmlLayout>
