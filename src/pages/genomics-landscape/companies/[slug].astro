---
import clsx from 'clsx';
import NavV2 from '@src/components/NavV2.astro';
import Seo from '@src/components/Seo';
import HtmlLayout from '@src/layouts/Html.astro';
import BodyLayout from '@src/layouts/Body.astro';
import HeadLayout from '@src/layouts/Head.astro';
import Footer from '@src/components/Footer';
import CompanyDetail from '@src/genomics/components/CompanyDetail';
import { enrichData } from '@src/genomics/utils/enrich';
import type { EnrichedCompany, EnrichedInvestor } from '@src/genomics/types';

export async function getStaticPaths() {
  const { companies, investors } = enrichData();
  return companies.map((company) => {
    return {
      params: { slug: company.slug },
      props: { company, investors },
    };
  });
}

const { company, investors } = Astro.props as {
  company: EnrichedCompany;
  investors: EnrichedInvestor[];
};
---

<HtmlLayout>
  <HeadLayout>
    <Seo
      title={`${company.name} - Genomics Landscape - Shivek Khurana`}
      subTitle={company.description ||
        'Mapping the genomics and biotech investment ecosystem'}
      authorName="Shivek Khurana"
      heroImg="/img/og.png"
    />
  </HeadLayout>

  <BodyLayout>
    <NavV2 />
    <main class={clsx('w-11/12 mx-auto lg:w-10/12 xl:w-8/12', 'mt-16 mb-24')}>
      <section class="font-mlm-roman">
        <div class={clsx('mb-6')}>
          <a
            href="/genomics-landscape/companies"
            class={clsx(
              'text-black',
              'hover:underline',
              'text-sm',
              'mb-4',
              'inline-block'
            )}
          >
            ← Back to Companies
          </a>
        </div>
        <CompanyDetail
          client:idle
          company={company}
          investors={investors}
        />
      </section>
    </main>
    <Footer />
  </BodyLayout>
</HtmlLayout>
