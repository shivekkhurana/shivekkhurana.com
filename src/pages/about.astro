---
import clsx from 'clsx';
import NavV2 from '@src/components/NavV2';
import MediaCard from '@src/components/MediaCard';
import Seo from '@src/components/Seo';
import HtmlLayout from '@src/layouts/Html.astro';
import BodyLayout from '@src/layouts/Body.astro';
import HeadLayout from '@src/layouts/Head.astro';
import Footer from '@src/components/Footer';

const shots = [
  {
    src: '/img/hero/warsaw.jpeg',
    alt: 'Shivek in Warsaw',
    title: 'Warsaw',
    type: 'image' as const,
  },
  {
    src: '/img/hero/porto.jpeg',
    alt: 'Walking in Porto garden',
    title: 'Porto',
    type: 'image' as const,
  },
  {
    src: '/img/hero/dubai.jpeg',
    alt: 'Dubai',
    title: 'Dubai',
    type: 'image' as const,
  },
  {
    src: '/video/clothing.mp4',
    alt: 'Warsaw',
    title: 'Fashion Talk',
    type: 'video' as const,
  },
];
---

<HtmlLayout>
  <HeadLayout>
    <Seo
      title="About"
      subTitle="Moments from my journey"
      heroImg="/img/og.png"
      authorName="Shivek Khurana"
    />
  </HeadLayout>

  <BodyLayout>
    <NavV2 client:idle />
    <main class={clsx('w-11/12 mx-auto lg:w-10/12 xl:w-8/12', 'mt-16')}>
      <div class="mt-48 mb-24 font-mlm-roman">
        <!-- Heading -->
        <h1 class="font-bold text-2xl md:text-3xl mb-6">About</h1>

        <!-- About Me Content -->
        <div class="prose prose-lg max-w-none mb-16">
          <section class="mb-12">
            <p class="mb-6 leading-relaxed">
              I build software systems that solve real problems. Over the last
              decade, I've worked across consumer apps, large-scale data
              platforms, financial tooling, and multi-agent AI workflows.
            </p>
            <p class="mb-6 leading-relaxed">
              My experience spans engineering, product, and business execution.
              I've shipped products used by millions, led teams, built
              revenue-generating systems, and advised companies on product and
              growth.
            </p>
          </section>

          <!-- Media cards grid -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-16">
            {
              shots.map((shot, index) => (
                <MediaCard
                  client:load
                  src={shot.src}
                  alt={shot.alt}
                  title={shot.title}
                  type={shot.type}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchPriority={index === 0 ? 'high' : undefined}
                />
              ))
            }
          </div>

          <section class="mb-12">
            <h2 class="font-bold text-xl md:text-2xl mb-6">What I Work On</h2>

            <div class="mb-8">
              <h3 class="font-semibold text-lg md:text-xl mb-3">
                Engineering & Infrastructure
              </h3>
              <ul class="list-disc list-inside mb-4 space-y-2">
                <li>Full-stack execution from backend to UI</li>
                <li>
                  Cloudflare Workers, Durable Objects, Hono, Postgres, WAL-G
                  PITR, Pulumi, AWS
                </li>
                <li>
                  Data pipelines, embeddings, RAG systems, and agent workflows
                </li>
                <li>
                  Automation for crypto-native and operationally heavy
                  businesses
                </li>
              </ul>
            </div>

            <div class="mb-8">
              <h3 class="font-semibold text-lg md:text-xl mb-3">
                Crypto & Finance
              </h3>
              <ul class="list-disc list-inside mb-4 space-y-2">
                <li>
                  Wallet UX, Layer-2 infra, Solana tooling, and Bittensor
                  staking flows
                </li>
                <li>Led wallet development at Status (1M+ downloads)</li>
                <li>
                  Designed multi-currency ledger systems, cost-basis engines,
                  APY and PnL tools
                </li>
                <li>
                  Built internal dashboards and accounting workflows for funds
                  and companies
                </li>
              </ul>
            </div>

            <div class="mb-8">
              <h3 class="font-semibold text-lg md:text-xl mb-3">
                AI & Automation
              </h3>
              <ul class="list-disc list-inside mb-4 space-y-2">
                <li>
                  Multi-agent research systems, macro analysis agents, and
                  accounting agents
                </li>
                <li>
                  RAG pipelines (LlamaIndex / Chroma / KùzuDB), function-calling
                  ecosystems
                </li>
                <li>
                  Process automation for SMBs and "Pantone-shade" businesses
                </li>
              </ul>
            </div>

            <div class="mb-8">
              <h3 class="font-semibold text-lg md:text-xl mb-3">
                Product & Business
              </h3>
              <ul class="list-disc list-inside mb-4 space-y-2">
                <li>
                  Built and scaled products in cybersecurity, insurance,
                  telecom, crypto, and AI
                </li>
                <li>Founder of Meta Blocks (Telegram games and Solana NFTs)</li>
                <li>Advisor to SkillsTrainer (1.2M+ users)</li>
                <li>
                  Experience running a consultancy and helping teams ship faster
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="font-bold text-xl md:text-2xl mb-6">How I Work</h2>
            <ul class="list-disc list-inside space-y-2">
              <li>
                I think in systems and optimize for clarity, not complexity.
              </li>
              <li>I prefer small, fast teams that ship and iterate.</li>
              <li>
                I enjoy multi-disciplinary work: engineering, finance, product,
                design.
              </li>
            </ul>
          </section>

          <section class="mb-12">
            <h2 class="font-bold text-xl md:text-2xl mb-6">Beyond Work</h2>
            <p class="mb-4 leading-relaxed">
              I've lived and worked across India, Portugal, Poland, and the UAE.
            </p>
            <p class="mb-4 leading-relaxed">
              Travel has shaped how I design systems.
            </p>
            <p class="mb-4 leading-relaxed">
              I treat health as infrastructure—sleep, training, meditation, and
              routines that support consistent output.
            </p>
            <p class="leading-relaxed">
              I design my own clothes and care abour dressing well.
            </p>
          </section>
        </div>
      </div>
    </main>
    <Footer />
  </BodyLayout>
</HtmlLayout>
