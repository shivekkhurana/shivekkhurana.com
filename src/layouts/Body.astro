---
import HireFloating from '@src/components/HireFloating';

const isHirePage = Astro.url.pathname === '/hire' || Astro.url.pathname === '/hire/';
---

<body class="overflow-x-hidden selection:bg-gray-200 selection:text-pink-700">
  <!-- <div
    class="bg-black h-auto min-h-8 flex items-center px-2 sm:px-4 text-white text-xs sm:text-sm justify-center text-center py-1.5 sm:py-0"
  >
    https://krimlabs.com has been migrated to https://shivekkhurana.com
  </div> -->
  <div class="relative bg-white m-2 border border-black">
    <slot />
    <!-- Invisible trigger for the floating hire CTA's end-of-page margin adjustment. -->
    <div
      class="hire-floating-page-end"
      aria-hidden="true"
    >
    </div>
  </div>
  {!isHirePage && <HireFloating />}
</body>
