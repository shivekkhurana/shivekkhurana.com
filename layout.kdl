layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="claude" {
        pane split_direction="vertical" {
            pane name="claude0" {
                command "claude"
            }
            pane name="claude1" {
                command "claude"
            }
        }
    }

    tab name="emacs" {
        pane name="emacs" {
            command "emacsclient"
            args "-t"
        }
    }

    tab name="server" {
        pane name="server" {
            command "bun"
            args "dev"
        }
    }

    tab name="terminal" {
        pane
    }
}
