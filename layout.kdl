layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="shivekkhurana.com" {
        pane split_direction="vertical" {
            pane stacked=true {
                pane name="emacs" {
                    command "emacsclient"
                    args "-t"
                }
                pane name="server" {
                    command "bun"
                    args "dev"
                }
            }
            pane stacked=true {
                pane name="claude0" {
                    command "claude"
                }
                pane name="claude1" {
                    command "claude"
                }
            }
        }
    }
}
